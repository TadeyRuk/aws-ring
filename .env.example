# --- Ring auth (choose ONE) -------------------------------------------------
# Playground token: short-lived, from https://developer.amazon.com/ring/console/playground
# RING_ACCESS_TOKEN=
# Production-style: OAuth refresh flow (needs a registered app)
# RING_REFRESH_TOKEN=
# RING_CLIENT_ID=
# RING_CLIENT_SECRET=

# HMAC signing key issued with partner credentials (verifies X-Signature on webhooks)
# RING_WEBHOOK_HMAC_KEY=

# --- Runtime ---------------------------------------------------------------
# Where events come from: mock (no Ring needed) | poll (Playground token, no webhook URL) | webhook
RINGDOOR_SOURCE=mock
RINGDOOR_DEVICE_ID=
RINGDOOR_POLL_SECONDS=3
